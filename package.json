{
  "name": "@farzai/tether",
  "version": "0.0.0",
  "private": true,
  "description": "Connect your own AI agent to web apps.",
  "license": "MIT",
  "type": "module",
  "repository": "github:farzai/tether",
  "bin": {
    "tether": "src/cli/bin.ts"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "tether": "bun src/cli/bin.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "conformance": "bun src/conformance/cli.ts",
    "fake-app": "bun test/fake-app/main.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
