{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/farzai/tether/main/schemas/v1/pair-poll.response.json",
  "title": "Pair poll response",
  "oneOf": [
    {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["pending", "denied", "expired"]
        }
      }
    },
    {
      "type": "object",
      "required": ["status", "device", "credential"],
      "properties": {
        "status": {
          "const": "approved"
        },
        "device": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": {
              "$ref": "common.json#/$defs/id"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "credential": {
          "type": "string",
          "minLength": 20
        }
      }
    }
  ]
}
