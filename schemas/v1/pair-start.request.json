{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/farzai/tether/main/schemas/v1/pair-start.request.json",
  "title": "Pair start request",
  "type": "object",
  "required": ["client", "device_name"],
  "properties": {
    "client": {
      "$ref": "common.json#/$defs/client"
    },
    "device_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  }
}
