{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/farzai/tether/main/schemas/v1/task-status.response.json",
  "title": "Task status response",
  "type": "object",
  "required": ["id", "status", "attempts"],
  "properties": {
    "id": {
      "$ref": "common.json#/$defs/id"
    },
    "status": {
      "$ref": "common.json#/$defs/task_status"
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "lease_expires_at": {
      "$ref": "common.json#/$defs/timestamp"
    }
  }
}
