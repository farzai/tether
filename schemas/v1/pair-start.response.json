{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/farzai/tether/main/schemas/v1/pair-start.response.json",
  "title": "Pair start response",
  "type": "object",
  "required": ["device_code", "user_code", "verification_uri", "interval", "expires_in"],
  "properties": {
    "device_code": {
      "type": "string",
      "minLength": 16
    },
    "user_code": {
      "type": "string",
      "minLength": 4,
      "maxLength": 20
    },
    "verification_uri": {
      "type": "string",
      "format": "uri"
    },
    "verification_uri_complete": {
      "type": "string",
      "format": "uri"
    },
    "interval": {
      "type": "integer",
      "minimum": 1
    },
    "expires_in": {
      "type": "integer",
      "minimum": 1
    }
  }
}
