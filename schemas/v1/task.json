{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/farzai/tether/main/schemas/v1/task.json",
  "title": "Task payload",
  "type": "object",
  "required": ["id", "type", "title", "instructions", "mcp", "tools", "limits"],
  "properties": {
    "id": { "$ref": "common.json#/$defs/id" },
    "type": { "type": "string", "minLength": 1, "maxLength": 200 },
    "title": {
      "type": "string",
      "maxLength": 500,
      "description": "Shown to the user only; never given to the agent."
    },
    "created_at": { "$ref": "common.json#/$defs/timestamp" },
    "instructions": {
      "type": "string",
      "description": "Written by the app's own code, never by a user or taken from the web. Goes to the agent as instructions."
    },
    "skill": {
      "type": "object",
      "required": ["name", "version", "markdown"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "markdown": { "type": "string" }
      },
      "description": "Written by the app's own code, like instructions."
    },
    "input": {
      "type": "object",
      "description": "Everything else the task needs, including any text written by users or fetched from the web. The client hands it to the agent as fenced data, never as instructions."
    },
    "mcp": {
      "type": "object",
      "required": ["url", "token"],
      "properties": {
        "url": {
          "$ref": "common.json#/$defs/app_url",
          "description": "Must equal the discovery document's mcp endpoint."
        },
        "token": {
          "$ref": "common.json#/$defs/secret",
          "description": "Issued fresh for each lease."
        }
      }
    },
    "tools": {
      "type": "object",
      "required": ["requested"],
      "properties": {
        "requested": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
          "uniqueItems": true
        }
      }
    },
    "limits": {
      "type": "object",
      "required": ["timeout_s", "max_budget_usd"],
      "properties": {
        "timeout_s": { "type": "integer", "minimum": 1 },
        "max_budget_usd": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
