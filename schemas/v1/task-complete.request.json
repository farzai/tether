{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/farzai/tether/main/schemas/v1/task-complete.request.json",
  "title": "Task complete request",
  "type": "object",
  "required": ["lease_id", "exit_code", "duration_ms"],
  "properties": {
    "lease_id": {
      "$ref": "common.json#/$defs/id"
    },
    "exit_code": {
      "type": "integer"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "usage": {
      "$ref": "common.json#/$defs/usage"
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
