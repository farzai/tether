{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/farzai/tether/main/schemas/v1/common.json",
  "title": "Shared definitions",
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "secret": {
      "description": "A secret issued by the app: at least 128 bits from a secure random source (22 or more characters).",
      "type": "string",
      "minLength": 22,
      "maxLength": 1000
    },
    "app_url": {
      "description": "An absolute HTTPS URL without userinfo or a percent sign in the authority, or plain HTTP on a loopback host (development and tests only).",
      "type": "string",
      "format": "uri",
      "maxLength": 2000,
      "pattern": "^(https://[^/?#@%]*([/?#]|$)|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]+)?(/|$))"
    },
    "client": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_tokens": { "type": "integer", "minimum": 0 },
        "cache_write_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "lease": {
      "type": "object",
      "required": ["id", "expires_at", "duration_s"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "duration_s": { "type": "integer", "minimum": 1 }
      }
    },
    "task_status": { "enum": ["queued", "leased", "completed", "failed", "cancelled"] }
  }
}
